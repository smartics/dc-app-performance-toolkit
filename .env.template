# =============================================================================
# SMARTICS DCAPT Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your actual values
#   chmod 600 .env
#   source .env
# =============================================================================

# -----------------------------------------------------------------------------
# Confluence Instance Configuration
# -----------------------------------------------------------------------------
CONFLUENCE_HOSTNAME=a4b78a3cab3364dbdb8afbea3a5f4685-2038387234.us-east-2.elb.amazonaws.com
CONFLUENCE_PROTOCOL=http
CONFLUENCE_PORT=80
CONFLUENCE_POSTFIX=/confluence
CONFLUENCE_ADMIN_USER=admin
CONFLUENCE_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Test Configuration
# -----------------------------------------------------------------------------
LOAD_EXECUTOR=locust
CONCURRENCY=200
TEST_DURATION=45m
RAMP_UP=5m

# -----------------------------------------------------------------------------
# Custom Dataset Query
# -----------------------------------------------------------------------------
# CQL query to filter pages for testing
# Examples:
#   title ~ 'Test Case'
#   space='MAN1' AND title ~ 'Versuch*'
#   space='PROJECTDOCTEST' AND (title = 'Test Case Display Table' OR title = 'Test Case Transclude from Documents')
CUSTOM_DATASET_QUERY=title ~ 'Test Case'

