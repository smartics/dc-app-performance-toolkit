# =============================================================================
# SMARTICS DCAPT Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your actual values
#   chmod 600 .env
# =============================================================================

# NOTE: Confluence test configuration (hostname, ports, etc.) is configured
# directly in app/confluence.yml and does not use environment variables.

# -----------------------------------------------------------------------------
# Smartics Documentation System (for convert-to-projectdoc-json.py)
# -----------------------------------------------------------------------------
# Source Confluence instance for documentation conversion
SMARTICS_DOC_SYSTEM_URL=https://www.smartics.eu/confluence
SMARTICS_DOC_SYSTEM_USERNAME=anton.kronseder
SMARTICS_DOC_SYSTEM_PASSWORD=CHANGEME

# -----------------------------------------------------------------------------
# Smartics System Under Test
# -----------------------------------------------------------------------------
# Target Confluence instance for performance testing
SMARTICS_TEST_SYSTEM_URL=https://c7perf.smartics.mobi
SMARTICS_TEST_SYSTEM_USERNAME=anton.kronseder
SMARTICS_TEST_SYSTEM_PASSWORD=CHANGEME

# -----------------------------------------------------------------------------
# Terraform Variables (for app/util/k8s/dcapt.tfvars)
# -----------------------------------------------------------------------------
# Set these as TF_VAR_* environment variables before running terraform
#
# Example usage:
#   export TF_VAR_environment_name="dcapt-confluence-e1"
#   export TF_VAR_products='["confluence"]'
#   export TF_VAR_confluence_license="YOUR_ACTUAL_LICENSE_KEY"
#   cd app/util/k8s
#   terraform plan -var-file=dcapt.tfvars
#
# Required Terraform Variables:
#   TF_VAR_environment_name          # e.g., "dcapt-confluence-e1"
#   TF_VAR_products                  # e.g., '["confluence"]'
#   TF_VAR_confluence_license        # Your Confluence license key
#   TF_VAR_jira_license              # Your Jira license key (if deploying Jira)
#   TF_VAR_jsm_license               # Your JSM license key (if deploying JSM)
#   TF_VAR_bitbucket_license         # Your Bitbucket license key (if deploying Bitbucket)
#   TF_VAR_crowd_license             # Your Crowd license key (if deploying Crowd)
#   TF_VAR_bamboo_license            # Your Bamboo license key (if deploying Bamboo)

# -----------------------------------------------------------------------------
# AWS Credentials (if using AWS deployment)
# -----------------------------------------------------------------------------
# Set these if deploying to AWS
#   AWS_ACCESS_KEY_ID=your_access_key
#   AWS_SECRET_ACCESS_KEY=your_secret_key
#   AWS_DEFAULT_REGION=us-east-2
