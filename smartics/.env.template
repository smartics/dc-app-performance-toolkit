# Smartics DCAPT Setup - Environment Variables
# Kopiere diese Datei nach .env und fülle die Werte aus:
#   cp .env.template .env
#
# WICHTIG: .env wird NICHT committed (in .gitignore)

# Confluence Verbindung
CONFLUENCE_URL=https://c10dcapt.smartics.eu
CONFLUENCE_USER=admin

# Authentifizierung (Token ODER Password)
# Token hat Vorrang vor Password
CONFLUENCE_TOKEN=your_personal_access_token_here
# CONFLUENCE_PASSWORD=your_password_here

# 1Password Service-Account-Token fuer smartics/fetch_aws_credentials.sh
# Holt die AWS-Credentials aus dem Vault und schreibt app/util/k8s/aws_envs.
# NICHT committen! (smartics/.env ist git-ignored)
# OP_SERVICE_ACCOUNT_TOKEN=ops_...
# Optional ueberschreiben (Defaults im Skript: Item "AWS-DCPT-TOKEN",
# Vault=auto (eindeutiger Titel), Felder username/password)
# OP_VAULT=
# OP_ITEM=AWS-DCPT-TOKEN
